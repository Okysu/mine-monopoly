{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"buildCommand": "pnpm --filter @mine-monopoly/env run build && pnpm --filter @mine-monopoly/client run build:web",
	"outputDirectory": "apps/client/dist/frontend",
	"rewrites": [
		{ "source": "/room-router", "destination": "/index.html" },
		{ "source": "/room", "destination": "/index.html" },
		{ "source": "/game", "destination": "/index.html" }
	],
	"headers": [
		{
			"source": "/assets/(.*)",
			"headers": [
				{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
			]
		}
	]
}
