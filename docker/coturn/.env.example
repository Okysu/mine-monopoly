# ============================================================================
# coturn 独立部署配置
# 复制为 .env 后按需修改：cp .env.example .env
# ============================================================================

# 本机公网 IP（必填）
# coturn 在 host 网络下看不到 NAT 后的公网地址，必须显式告知，
# 否则 TURN 分配到的中继地址是内网 IP，客户端连不上。
EXTERNAL_IP=1.2.3.4

# 必须与 monopoly 服务端的 TURN_SECRET 完全一致
TURN_SECRET=change-me-turn-secret

# realm：填你的域名即可，只影响客户端展示，不参与 HMAC 校验
TURN_REALM=turn.example.com

# TURN 中继端口范围（UDP）
# 每个并发的 TURN 中继连接占用 1 个端口。默认的 49152-65535 是 16384 个端口，
# 对个人服完全没必要；40~100 个端口就够几十人同时联机了。
# 按需缩小/扩大，记得防火墙和安全组放行同一范围。
TURN_MIN_PORT=49160
TURN_MAX_PORT=49200

# TLS 证书目录（里面同时有 fullchain.pem 和 privkey.pem 才会启用 turns:）
# 没有证书也能跑，只是只能走 turn:（UDP/TCP 3478）
COTURN_CERTS_PATH=./certs
